# ============================================
# Telegram Copier Bot - Environment Variables
# ============================================

# --- Telegram API credentials ---
# Get from: https://my.telegram.org → API Development Tools
TG_API_ID=1234567
TG_API_HASH=your_api_hash_here

# --- Bot Token ---
# Get from: @BotFather → /newbot
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- Telethon Session Name ---
SESSION_NAME=copier_session

# --- Admin Telegram User ID ---
# Get from: @userinfobot (apni ID yahan daalo)
# Sirf yeh user bot ke buttons use kar sakta hai
ADMIN_ID=123456789
